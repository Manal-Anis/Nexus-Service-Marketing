@{
    var title = ViewData["Title"] as string ?? "Nexus Service Marketing System";
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Nexus offers dial-up internet, broadband and landline connections across Pakistan with transparent pricing, bulk discounts and cash on delivery billing.")" />
    <title>@title | Nexus</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Cinzel:wght@500;600&family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/aos/aos.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script>document.documentElement.classList.add("js");</script>
    <link rel="icon" href="~/favicon.ico" />
</head>
<body class="nexus-body">
    <!-- ============================================================ navbar -->
    <header class="nexus-navbar">
        <nav class="navbar navbar-expand-lg container py-2">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-diagram-3-fill"></i></span>
                <span class="brand-word">NEXUS</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link nav-underline @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-underline @(currentAction == "Plans" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Plans">Plans</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-underline @(currentAction == "TrackOrder" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="TrackOrder">Track Order</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-underline @(currentAction == "CheckConnection" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="CheckConnection">Check Connection</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-underline @(currentAction == "About" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-underline @(currentAction == "Contact" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <div class="dropdown">
                                <button class="btn btn-ghost btn-sm dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle text-gold"></i>
                                    <span>@(User.Identity.Name ?? "Account")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin dashboard</a></li>
                                    }
                                    else if (User.IsInRole("Vendor"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Vendor" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Vendor dashboard</a></li>
                                    }
                                    else if (User.IsInRole("Customer"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Customer" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>My dashboard</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Context.Request.Path" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
                        </li>
                        <li class="nav-item mt-2 mt-lg-0">
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-outline-gold btn-sm px-3" asp-area="" asp-controller="Account" asp-action="RegisterVendor"><i class="bi bi-shop me-1"></i>Join as partner</a>
                                <a class="btn btn-gold btn-sm px-3" asp-area="" asp-controller="Account" asp-action="Register">Get connected</a>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <!-- ============================================================ content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ============================================================ footer -->
    <footer class="glass-footer no-print">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-mark"><i class="bi bi-diagram-3-fill"></i></span>
                        <span class="brand-word fs-4">NEXUS</span>
                    </div>
                    <p class="text-muted-silver fs-14 mb-3">
                        Dial-up internet, broadband and landline services for homes, students and businesses -
                        installed by the nearest Nexus retail partner and billed on delivery.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-muted-silver" aria-label="Facebook"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-muted-silver" aria-label="Twitter"><i class="bi bi-twitter-x fs-5"></i></a>
                        <a href="#" class="text-muted-silver" aria-label="LinkedIn"><i class="bi bi-linkedin fs-5"></i></a>
                        <a href="#" class="text-muted-silver" aria-label="YouTube"><i class="bi bi-youtube fs-5"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>Services</h6>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a asp-area="" asp-controller="Home" asp-action="Plans">Dial-up internet</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Plans">Broadband</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Plans">Landline</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="CheckConnection">Check availability</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>Company</h6>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a asp-area="" asp-controller="Home" asp-action="About">About us</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="RegisterVendor">Become a partner</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="AdminLogin"><i class="bi bi-shield-lock me-1"></i>Admin portal</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Login">Demo logins</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="TrackOrder">Track an order</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>Legal</h6>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy policy</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Terms">Terms of service</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="ForgotPassword">Reset password</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6>Support</h6>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><span class="text-muted-silver"><i class="bi bi-telephone me-2"></i>111-123456</span></li>
                        <li><span class="text-muted-silver"><i class="bi bi-envelope me-2"></i>support@nexus.com</span></li>
                        <li><span class="text-muted-silver"><i class="bi bi-clock me-2"></i>9:00 - 21:00</span></li>
                        <li><span class="text-muted-silver"><i class="bi bi-cash-coin me-2"></i>Cash on delivery</span></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-wrap justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year Nexus Communication System. All rights reserved.</span>
                <span>Crafted for the Nexus Service Marketing System &middot; version 1.0</span>
            </div>
        </div>
    </footer>

    <button type="button" class="back-to-top" aria-label="Back to top"><i class="bi bi-arrow-up"></i></button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/aos/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.AOS) {
                AOS.init({ duration: 800, easing: 'ease-out-cubic', once: true, offset: 60 });
            }
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                document.cookie = "X-CSRF-TOKEN=" + token.value + "; path=/";
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
