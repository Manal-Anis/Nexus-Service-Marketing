@{
    var title = ViewData["Title"] as string ?? "Invoice";
    var backUrl = ViewData["BackUrl"] as string ?? "/";
    var backText = ViewData["BackText"] as string ?? "Back";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title | Nexus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="nexus-body">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3 no-print">
            <a class="btn btn-ghost btn-sm" href="@backUrl"><i class="bi bi-arrow-left me-1"></i>@backText</a>
            <button type="button" class="btn btn-gold btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print invoice</button>
        </div>

        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
