@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change the password";
}

<section class="container py-5">
    <div class="auth-card glass" data-reveal>
        <div class="text-center mb-4">
            <span class="brand-mark mx-auto mb-3" style="width:54px;height:54px;font-size:1.4rem;"><i class="bi bi-shield-lock-fill"></i></span>
            <h1 class="h4 mb-1">Change your password</h1>
            <p class="text-muted-silver fs-14 mb-0">You stay signed in on this device after the change.</p>
        </div>

        @if (TempData["Success"] is string success)
        {
            <div class="alert-nexus alert-success mb-4">
                <i class="bi bi-check-circle-fill"></i>
                <div>@success</div>
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="ChangePassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="CurrentPassword">Current password</label>
                <div class="password-wrapper">
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <button type="button" class="password-toggle" aria-label="Show the password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger fs-14"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="NewPassword">New password</label>
                <div class="password-wrapper">
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <button type="button" class="password-toggle" aria-label="Show the password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger fs-14"></span>
            </div>

            <div class="mb-4">
                <label class="form-label" asp-for="ConfirmPassword">Repeat the new password</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <button type="button" class="password-toggle" aria-label="Show the password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger fs-14"></span>
            </div>

            <button type="submit" class="btn btn-gold w-100 btn-lg">Save the password</button>
        </form>
    </div>
</section>
