@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="container py-5">
    <div class="auth-card glass" data-reveal>
        <div class="text-center mb-4">
            <span class="brand-mark mx-auto mb-3" style="width:54px;height:54px;font-size:1.4rem;"><i class="bi bi-diagram-3-fill"></i></span>
            <h1 class="h4 mb-1">Welcome back</h1>
            <p class="text-muted-silver fs-14 mb-0">Customers and partners sign in here, to follow orders, bills and connections.</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Email">Email address</label>
                <div class="position-relative">
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger fs-14"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Password">Password</label>
                <div class="password-wrapper">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <button type="button" class="password-toggle" aria-label="Show the password"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Password" class="text-danger fs-14"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="RememberMe" type="checkbox" />
                    <label class="form-check-label text-muted-silver fs-14" asp-for="RememberMe"></label>
                </div>
                <a class="fs-14" asp-controller="Account" asp-action="ForgotPassword">Forgot the password?</a>
            </div>

            <button type="submit" class="btn btn-gold w-100 btn-lg">Sign in</button>
        </form>

        <hr class="divider-gold my-4" />

        <p class="text-center text-muted-silver fs-14 mb-3">New to Nexus? Choose how you want to join.</p>
        <div class="row g-2">
            <div class="col-6">
                <a class="btn btn-outline-gold w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3"
                   asp-controller="Account" asp-action="Register">
                    <i class="bi bi-person-plus fs-4 mb-1"></i>
                    <span class="fw-600">Customer</span>
                    <span class="fs-14 text-muted-silver">Create an account</span>
                </a>
            </div>
            <div class="col-6">
                <a class="btn btn-outline-gold w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3"
                   asp-controller="Account" asp-action="RegisterVendor">
                    <i class="bi bi-shop fs-4 mb-1"></i>
                    <span class="fw-600">Partner</span>
                    <span class="fs-14 text-muted-silver">Join as a vendor</span>
                </a>
            </div>
        </div>
        <p class="text-center fs-14 mt-3 mb-0">
            <a asp-controller="Account" asp-action="AdminLogin"><i class="bi bi-shield-lock me-1"></i>Administrator sign in</a>
        </p>
    </div>

    <partial name="_DemoAccess" model='"all"' />
</section>
