@{
    ViewData["Title"] = "Check your inbox";
}

<section class="container py-5">
    <div class="auth-card glass" data-reveal>
        <div class="text-center mb-4">
            <span class="brand-mark mx-auto mb-3" style="width:54px;height:54px;font-size:1.4rem;"><i class="bi bi-envelope-check-fill"></i></span>
            <h1 class="h4 mb-1">Reset link sent</h1>
            <p class="text-muted-silver fs-14">
                If an account exists for that address, a reset link has been prepared. The link stays valid until
                the password has been changed.
            </p>
        </div>

        @if (TempData["ResetLink"] is string resetLink)
        {
            <div class="alert-nexus alert-info mb-4">
                <i class="bi bi-info-circle-fill"></i>
                <div class="fs-14">
                    <strong>Mail server not configured.</strong>
                    <div class="mt-1" style="word-break:break-all;">Use this link to set the new password:</div>
                    <a href="@resetLink">@resetLink</a>
                </div>
            </div>
        }

        <a class="btn btn-gold w-100" asp-controller="Account" asp-action="Login">Back to the sign in</a>
    </div>
</section>
