@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset the password";
}

<section class="container py-5">
    <div class="auth-card glass" data-reveal>
        <div class="text-center mb-4">
            <span class="brand-mark mx-auto mb-3" style="width:54px;height:54px;font-size:1.4rem;"><i class="bi bi-key-fill"></i></span>
            <h1 class="h4 mb-1">Forgot your password?</h1>
            <p class="text-muted-silver fs-14 mb-0">Enter the email address of your account and we will send a reset link.</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="ForgotPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-4">
                <label class="form-label" asp-for="Email">Email address</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger fs-14"></span>
            </div>

            <button type="submit" class="btn btn-gold w-100 btn-lg">Send the reset link</button>
        </form>

        <hr class="divider-gold my-4" />

        <p class="text-center text-muted-silver fs-14 mb-0">
            <a asp-controller="Account" asp-action="Login">Back to the sign in</a>
        </p>
    </div>
</section>
