@{
    ViewData["Title"] = "About Nexus";
}

<section class="hero" style="min-height:52vh;">
    <div class="orb-stage">
        <span class="orb orb-gold orb-1"></span>
        <span class="orb orb-silver orb-3"></span>
    </div>
    <div class="container position-relative text-center">
        <span class="eyebrow" data-reveal>About us</span>
        <h1 class="hero-title mt-2" data-reveal="80">A network built street by street</h1>
        <p class="section-lead mx-auto mt-3" data-reveal="140">
            Nexus Communication System connects households, students and businesses with dial-up internet,
            broadband and landline services. We work through approved retail partners so that every installation
            is done by someone who knows the exchange, the street and the customer.
        </p>
    </div>
</section>

<section class="container py-5">
    <div class="row g-4">
        <div class="col-lg-4" data-reveal>
            <div class="feature-card glass glass-hover h-100">
                <i class="bi bi-bullseye icon"></i>
                <h2 class="h5">Our mission</h2>
                <p class="text-muted-silver fs-14 mb-0">
                    Make a reliable line affordable for every household, with a transparent price list, a fair
                    bulk discount and a bill that can be settled in cash at the counter of the shop that
                    installed the service.
                </p>
            </div>
        </div>
        <div class="col-lg-4" data-reveal="80">
            <div class="feature-card glass glass-hover h-100">
                <i class="bi bi-eye icon"></i>
                <h2 class="h5">Our vision</h2>
                <p class="text-muted-silver fs-14 mb-0">
                    Become the reference point for transparent connectivity in Pakistan, where the customer always
                    knows the price before the order, the state of the order during the installation and the exact
                    amount that is due on the invoice.
                </p>
            </div>
        </div>
        <div class="col-lg-4" data-reveal="160">
            <div class="feature-card glass glass-hover h-100">
                <i class="bi bi-gem icon"></i>
                <h2 class="h5">Our values</h2>
                <p class="text-muted-silver fs-14 mb-0">
                    Honesty in the price list, cash on delivery instead of hidden charges, a documented feasibility
                    survey before any installation and an audit trail for every change made on an account.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6" data-reveal>
            <span class="eyebrow">Our history</span>
            <h2 class="section-title mt-2">From one exchange to ten cities</h2>
            <div class="glass p-4 mt-4">
                <div class="stat-line"><span class="k">1998</span><span class="v">The first Nexus dial-up pool opens in Karachi</span></div>
                <div class="stat-line"><span class="k">2004</span><span class="v">Landline voice service starts on the same exchange</span></div>
                <div class="stat-line"><span class="k">2009</span><span class="v">Broadband replaces the modem pool in Lahore</span></div>
                <div class="stat-line"><span class="k">2015</span><span class="v">Retail partner network expands to Islamabad and Rawalpindi</span></div>
                <div class="stat-line"><span class="k">2026</span><span class="v">The service marketing system brings every order online</span></div>
            </div>
        </div>
        <div class="col-lg-6" data-reveal="120">
            <div class="glass p-4">
                <h2 class="h5 mb-3">How we work with our partners</h2>
                <ul class="list-unstyled d-grid gap-3 mb-0">
                    <li class="d-flex gap-3"><i class="bi bi-check-circle-fill text-gold"></i><span class="text-silver">Every partner is approved by the administrator before a single order is accepted.</span></li>
                    <li class="d-flex gap-3"><i class="bi bi-check-circle-fill text-gold"></i><span class="text-silver">Technical staff run the feasibility survey, the accounts staff issue the bills and the manager supervises the cash.</span></li>
                    <li class="d-flex gap-3"><i class="bi bi-check-circle-fill text-gold"></i><span class="text-silver">Bulk orders are discounted automatically on the advance payment and the security deposit.</span></li>
                    <li class="d-flex gap-3"><i class="bi bi-check-circle-fill text-gold"></i><span class="text-silver">Every sensitive action is written to an audit log that the administrator can review.</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>
