@{
    var code = ViewData["StatusCode"] as int? ?? 404;
    var isNotFound = code == 404;
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center">
            <div class="glass p-4 p-lg-5 mt-4" data-reveal>
                <div class="step-number" style="font-size:5rem;">@code</div>
                <h1 class="section-title mt-2">@(isNotFound ? "This page could not be found" : "Something went wrong")</h1>
                <p class="section-lead mx-auto mt-3">
                    @(isNotFound
                        ? "The link may be out of date or the address may contain a typo. The pages below will take you back on track."
                        : "The request could not be completed. The incident has been logged, please try again in a moment.")
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                    <a class="btn btn-gold" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Back to the home page</a>
                    <a class="btn btn-outline-gold" asp-controller="Home" asp-action="Plans"><i class="bi bi-collection me-2"></i>Browse the plans</a>
                    <a class="btn btn-ghost" asp-controller="Home" asp-action="Contact"><i class="bi bi-chat-dots me-2"></i>Contact support</a>
                </div>
            </div>
        </div>
    </div>
</section>
