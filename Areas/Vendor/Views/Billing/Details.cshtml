@model Bill
@{
    ViewData["Title"] = $"Invoice {Model.BillNumber}";
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4">
        <i class="bi bi-check-circle-fill"></i>
        <div>@success</div>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-3">
            <h1 class="h4 mb-0">@Model.BillNumber</h1>
            @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(Model.Status))
        </div>
        <p class="text-muted-silver fs-14 mb-0 mt-1">
            @Model.BillType.ToDisplayName() · @Model.PeriodStart.ToString("dd MMM yyyy") to @Model.PeriodEnd.ToString("dd MMM yyyy")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-ghost btn-sm" asp-area="Vendor" asp-controller="Billing" asp-action="Print" asp-route-id="@Model.Id">
            <i class="bi bi-printer me-1"></i>Print
        </a>
        <a class="btn btn-gold btn-sm" asp-area="Vendor" asp-controller="Payments" asp-action="Record" asp-route-billId="@Model.Id">
            <i class="bi bi-cash-stack me-1"></i>Record a receipt
        </a>
        <a class="btn btn-ghost btn-sm" asp-area="Vendor" asp-controller="Billing" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Charges</h2>
            <div class="table-wrap">
                <table class="table-glass">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Type</th>
                            <th class="num">Quantity</th>
                            <th class="num">Unit price</th>
                            <th class="num">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Lines.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-muted-silver fs-14">No charge line has been posted on this invoice.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var line in Model.Lines.OrderBy(l => l.SortOrder))
                            {
                                <tr>
                                    <td class="text-silver">@line.Description</td>
                                    <td class="fs-14">@line.LineType</td>
                                    <td class="num fs-14">@line.Quantity.ToString("N2")</td>
                                    <td class="num fs-14">@line.UnitPrice.ToString("N2")</td>
                                    <td class="num text-silver">@line.Amount.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="glass p-4">
            <h2 class="h5 mb-3">Payments received</h2>
            @if (Model.Payments.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No cash has been received against this invoice yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Date</th>
                                <th>Received by</th>
                                <th class="num">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaidOn))
                            {
                                <tr>
                                    <td class="text-silver">@payment.ReceiptNumber</td>
                                    <td class="fs-14">@payment.PaidOn.ToString("dd MMM yyyy")</td>
                                    <td class="fs-14">@payment.ReceivedByName</td>
                                    <td class="num text-silver">@payment.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Summary</h2>
            <div class="stat-line"><span class="k">Plan charge</span><span class="v">@Model.PlanCharge.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">Local calls</span><span class="v">@Model.LocalChargeAmount.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">STD calls</span><span class="v">@Model.StdChargeAmount.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">Mobile messages</span><span class="v">@Model.MobileChargeAmount.ToString("N2")</span></div>
            @if (Model.EquipmentChargeAmount > 0)
            {
                <div class="stat-line"><span class="k">Equipment</span><span class="v">@Model.EquipmentChargeAmount.ToString("N2")</span></div>
            }
            @if (Model.ReplacementChargeAmount > 0)
            {
                <div class="stat-line"><span class="k">Replacement</span><span class="v">@Model.ReplacementChargeAmount.ToString("N2")</span></div>
            }
            @if (Model.PreviousDue > 0)
            {
                <div class="stat-line"><span class="k">Previous due</span><span class="v">@Model.PreviousDue.ToString("N2")</span></div>
            }
            @if (Model.DiscountAmount > 0)
            {
                <div class="stat-line"><span class="k">Discount (@Model.DiscountPercent.ToString("0.##")%)</span><span class="v">- @Model.DiscountAmount.ToString("N2")</span></div>
            }
            <div class="stat-line"><span class="k">Sub total</span><span class="v">@Model.SubTotal.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">Tax (@Model.TaxPercent.ToString("0.##")%)</span><span class="v">@Model.TaxAmount.ToString("N2")</span></div>
            <div class="stat-line stat-total"><span class="k">Total</span><span class="v text-gold">@Model.TotalAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Paid</span><span class="v">@Model.AmountPaid.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">Amount due</span><span class="v">@Model.AmountDue.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">Due date</span><span class="v">@Model.DueDate.ToString("dd MMM yyyy")</span></div>
            <div class="stat-line"><span class="k">Generated</span><span class="v">@Model.GeneratedOn.ToString("dd MMM yyyy") by @Model.GeneratedByName</span></div>
        </div>

        <div class="glass p-4">
            <h2 class="h5 mb-3">Account</h2>
            <div class="stat-line"><span class="k">Account id</span><span class="v">@Model.Connection?.AccountId</span></div>
            <div class="stat-line"><span class="k">Plan</span><span class="v">@Model.Connection?.Plan?.Name</span></div>
            <div class="stat-line"><span class="k">Partner</span><span class="v">@Model.Connection?.Vendor?.BusinessName</span></div>
            <div class="stat-line"><span class="k">City</span><span class="v">@Model.Connection?.City?.Name</span></div>
            <div class="stat-line"><span class="k">Customer</span><span class="v">@Model.Connection?.Customer?.FullName</span></div>
        </div>
    </div>
</div>
