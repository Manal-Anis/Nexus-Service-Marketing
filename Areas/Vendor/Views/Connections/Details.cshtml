@model Connection
@{
    ViewData["Title"] = $"Connection {Model.AccountId}";
    var canOperate = (bool?)ViewData["CanOperate"] ?? false;
    var canBill = (bool?)ViewData["CanBill"] ?? false;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4">
        <i class="bi bi-check-circle-fill"></i>
        <div>@success</div>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-nexus alert-danger mb-4">
        <i class="bi bi-x-circle-fill"></i>
        <div>@error</div>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="account-id-chip fs-6">@Model.AccountId</span>
        @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(Model.Status))
    </div>
    <a class="btn btn-ghost btn-sm" asp-area="Vendor" asp-controller="Connections" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Back to the connections
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- ------------------------------------------------------------- summary -->
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Connection details</h2>

            <div class="stat-line"><span class="k">Customer</span><span class="v">@Model.Customer?.FullName</span></div>
            <div class="stat-line"><span class="k">Plan</span><span class="v">@Model.Plan?.Name</span></div>
            <div class="stat-line"><span class="k">Service</span><span class="v">@Model.Plan?.Category?.Name</span></div>
            <div class="stat-line"><span class="k">Monthly charge</span><span class="v">@Model.MonthlyCharge.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">City</span><span class="v">@Model.City?.Name</span></div>
            <div class="stat-line"><span class="k">Address</span><span class="v">@Model.InstallationAddress</span></div>
            <div class="stat-line"><span class="k">Contact</span><span class="v">@Model.ContactNumber</span></div>
            <div class="stat-line"><span class="k">Activated</span><span class="v">@Model.ActivationDate.ToString("dd MMM yyyy")</span></div>
            <div class="stat-line"><span class="k">Order</span><span class="v">@Model.Order?.OrderId</span></div>
            @if (Model.Status != ConnectionStatus.Active)
            {
                <div class="stat-line"><span class="k">State reason</span><span class="v">@Model.StatusReason</span></div>
                <div class="stat-line"><span class="k">Changed on</span><span class="v">@Model.StatusChangedAt?.ToString("dd MMM yyyy")</span></div>
            }
        </div>

        <!-- ------------------------------------------------------------- equipment -->
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Issued equipment</h2>

            @if (Model.Equipment.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No device has been issued on this connection.</p>
            }
            else
            {
                <div class="d-grid gap-2 mb-3">
                    @foreach (var device in Model.Equipment.OrderByDescending(e => e.AssignedAt))
                    {
                        <div class="doc-tile">
                            <span class="icon"><i class="bi bi-router"></i></span>
                            <div class="flex-grow-1">
                                <div class="text-silver fw-600 fs-14">@device.Product?.Name</div>
                                <small class="text-muted-silver">
                                    Serial @device.SerialNumber - issued on @device.AssignedAt.ToString("dd MMM yyyy")
                                    @if (device.IsReplaced)
                                    {
                                        <span class="text-danger-silver">- replaced</span>
                                    }
                                </small>
                                @if (!string.IsNullOrWhiteSpace(device.ReplacementReason))
                                {
                                    <small class="text-danger-silver d-block">@device.ReplacementReason - @device.ReplacementChargeAmount.ToString("N2") Rs</small>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (canOperate)
            {
                <button class="btn btn-ghost btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#replaceBox">
                    <i class="bi bi-arrow-repeat me-1"></i>Report a damaged device
                </button>

                <div class="collapse mt-3" id="replaceBox">
                    <form method="post" asp-area="Vendor" asp-controller="Connections" asp-action="ReplaceEquipment">
                        <input type="hidden" name="ConnectionId" value="@Model.Id" />
                        <label class="form-label" for="replaceReason">Reason</label>
                        <textarea class="form-control mb-2" id="replaceReason" name="Reason" rows="2" required></textarea>
                        <label class="form-label" for="replaceCharge">Replacement charge (Rs)</label>
                        <input class="form-control mb-3" id="replaceCharge" name="Charge" type="number" min="0" step="0.01" value="0" />
                        <button class="btn btn-danger-soft" type="submit">
                            <i class="bi bi-check2 me-1"></i>Record the replacement
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- ------------------------------------------------------------- plan changes -->
        @if (Model.PlanChanges.Count > 0)
        {
            <div class="glass p-4">
                <h2 class="h5 mb-3">Plan change history</h2>
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr>
                                <th>From</th>
                                <th>To</th>
                                <th>Reason</th>
                                <th>Requested</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var change in Model.PlanChanges.OrderByDescending(c => c.RequestedAt))
                            {
                                <tr>
                                    <td class="fs-14">@change.OldPlan?.Name</td>
                                    <td class="fs-14 text-gold">@change.NewPlan?.Name</td>
                                    <td class="fs-14 text-muted-silver">@change.Reason</td>
                                    <td class="fs-14">@change.RequestedAt.ToString("dd MMM yyyy")</td>
                                    <td class="fs-14">@change.Status.ToDisplayName()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <!-- ------------------------------------------------------------- bills -->
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Bills of this connection</h2>

            @if (Model.Bills.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No bill has been raised yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr>
                                <th>Bill</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bill in Model.Bills.OrderByDescending(b => b.GeneratedOn))
                            {
                                <tr>
                                    <td class="fs-14">@bill.BillNumber</td>
                                    <td class="fs-14 text-muted-silver">@bill.BillType.ToDisplayName()</td>
                                    <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(bill.Status))</td>
                                    <td class="num text-silver">@bill.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (canBill)
            {
                <a class="btn btn-gold w-100 mt-3" asp-area="Vendor" asp-controller="Billing" asp-action="Create" asp-route-connectionId="@Model.Id">
                    <i class="bi bi-file-earmark-plus me-1"></i>Generate a periodic bill
                </a>
            }
        </div>

        <!-- ------------------------------------------------------------- state -->
        @if (canOperate)
        {
            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">Change the service state</h2>
                <form method="post" asp-area="Vendor" asp-controller="Connections" asp-action="ChangeStatus">
                    <input type="hidden" name="ConnectionId" value="@Model.Id" />
                    <label class="form-label" for="newStatus">New state</label>
                    <select class="form-select mb-3" id="newStatus" name="Status">
                        @foreach (var status in Enum.GetValues<ConnectionStatus>())
                        {
                            <option value="@status" selected="@(status == Model.Status)">@status.ToDisplayName()</option>
                        }
                    </select>
                    <label class="form-label" for="statusReason">Reason</label>
                    <textarea class="form-control mb-3" id="statusReason" name="Reason" rows="2"
                              placeholder="The bills are overdue since 3 months." required></textarea>
                    <button class="btn btn-gold w-100" type="submit">
                        <i class="bi bi-check2-circle me-1"></i>Save the state
                    </button>
                </form>
            </div>
        }

        <!-- ------------------------------------------------------------- plan change -->
        @if (canOperate)
        {
            <div class="glass p-4">
                <h2 class="h5 mb-3">Move to another plan</h2>
                <form method="post" asp-area="Vendor" asp-controller="Connections" asp-action="ChangePlan">
                    <input type="hidden" name="ConnectionId" value="@Model.Id" />
                    <label class="form-label" for="newPlan">New plan</label>
                    <select class="form-select mb-3" id="newPlan" name="NewPlanId">
                        <option value="">Choose a plan</option>
                        @foreach (var plan in (List<Plan>)(ViewData["Plans"] ?? new List<Plan>()))
                        {
                            <option value="@plan.Id">@plan.Category.Name - @plan.Name - @plan.Price.ToString("N0") Rs</option>
                        }
                    </select>
                    <label class="form-label" for="planReason">Reason</label>
                    <input class="form-control mb-3" id="planReason" name="Reason" placeholder="The customer upgraded the package" />
                    <button class="btn btn-outline-gold w-100" type="submit">
                        <i class="bi bi-arrow-left-right me-1"></i>Apply the plan change
                    </button>
                </form>
            </div>
        }
    </div>
</div>
