@model Order
@{
    ViewData["Title"] = $"Order {Model.OrderId}";
    var canOperate = (bool?)ViewData["CanOperate"] ?? false;
    var canCancel = (bool?)ViewData["CanCancel"] ?? false;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4">
        <i class="bi bi-check-circle-fill"></i>
        <div>@success</div>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-nexus alert-danger mb-4">
        <i class="bi bi-x-circle-fill"></i>
        <div>@error</div>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="order-id-chip fs-6">@Model.OrderId</span>
        @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(Model.Status))
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (canOperate && (Model.Status == OrderStatus.Placed || Model.Status == OrderStatus.FeasibilityPending))
        {
            <a class="btn btn-gold btn-sm" asp-area="Vendor" asp-controller="Feasibility" asp-action="Index" asp-route-orderId="@Model.OrderId">
                <i class="bi bi-clipboard2-pulse me-1"></i>Record the survey
            </a>
        }
        @if (canOperate && Model.Status == OrderStatus.Feasible)
        {
            <a class="btn btn-gold btn-sm" asp-area="Vendor" asp-controller="Connections" asp-action="Create" asp-route-orderId="@Model.OrderId">
                <i class="bi bi-router me-1"></i>Create the connection
            </a>
        }
        <a class="btn btn-ghost btn-sm" asp-area="Vendor" asp-controller="Orders" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Back to the orders
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- ------------------------------------------------------------- timeline -->
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-4">Progress</h2>
            <ul class="timeline">
                @foreach (var history in Model.StatusHistory.OrderBy(h => h.ChangedAt))
                {
                    <li class="timeline-item">
                        <span class="timeline-dot @(history.ToStatus is OrderStatus.NotFeasible or OrderStatus.Cancelled ? "fail" : "done")"></span>
                        <div class="timeline-title">@history.ToStatus.ToDisplayName()</div>
                        <div class="timeline-meta">@history.ChangedAt.ToString("dd MMM yyyy, hh:mm tt") @(string.IsNullOrWhiteSpace(history.ChangedByName) ? "" : "- " + history.ChangedByName)</div>
                        @if (!string.IsNullOrWhiteSpace(history.Remark))
                        {
                            <div class="text-muted-silver fs-14">@history.Remark</div>
                        }
                    </li>
                }
            </ul>
        </div>

        <!-- ------------------------------------------------------------- feasibility -->
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Feasibility checks</h2>

            @if (Model.FeasibilityChecks.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No check has been opened for this order yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr>
                                <th>Check</th>
                                <th>Result</th>
                                <th>Remarks</th>
                                <th>Recorded</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var check in Model.FeasibilityChecks)
                            {
                                <tr>
                                    <td class="text-silver">@check.CheckType.ToDisplayName()</td>
                                    <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(check.Result))</td>
                                    <td class="text-muted-silver fs-14">
                                        @check.Remarks
                                        @if (!string.IsNullOrWhiteSpace(check.DistanceParameters))
                                        {
                                            <div class="mt-1"><i class="bi bi-rulers me-1"></i>@check.DistanceParameters</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(check.ServerAvailability))
                                        {
                                            <div><i class="bi bi-hdd-network me-1"></i>@check.ServerAvailability</div>
                                        }
                                    </td>
                                    <td class="fs-14 text-muted-silver">
                                        @(check.CheckedAt?.ToString("dd MMM yyyy") ?? "-")
                                        @if (!string.IsNullOrWhiteSpace(check.CheckedByName))
                                        {
                                            <div class="fs-14">@check.CheckedByName</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ------------------------------------------------------------- documents -->
        @if (Model.Documents.Count > 0)
        {
            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">Uploaded documents</h2>
                <div class="d-grid gap-2">
                    @foreach (var document in Model.Documents)
                    {
                        <div class="doc-tile">
                            <span class="icon"><i class="bi bi-file-earmark-text"></i></span>
                            <div class="flex-grow-1">
                                <div class="text-silver fw-600 fs-14">@document.OriginalFileName</div>
                                <small class="text-muted-silver">@document.DocumentType - @((document.FileSizeBytes / 1024.0).ToString("0")) KB</small>
                            </div>
                            <a class="btn btn-ghost btn-sm" asp-area="Vendor" asp-controller="Customers" asp-action="Document" asp-route-id="@document.Id">
                                <i class="bi bi-download"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ------------------------------------------------------------- connections -->
        @if (Model.Connections.Any())
        {
            <div class="glass p-4">
                <h2 class="h5 mb-3">Connections of this order</h2>
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr>
                                <th>Account id</th>
                                <th>Activated</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var connection in Model.Connections)
                            {
                                <tr>
                                    <td><span class="account-id-chip">@connection.AccountId</span></td>
                                    <td class="fs-14">@connection.ActivationDate.ToString("dd MMM yyyy")</td>
                                    <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(connection.Status))</td>
                                    <td class="text-end">
                                        <a class="btn btn-ghost btn-sm" asp-area="Vendor" asp-controller="Connections" asp-action="Details" asp-route-id="@connection.Id">Open</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <!-- ------------------------------------------------------------- summary -->
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Order details</h2>

            <div class="stat-line"><span class="k">Customer</span><span class="v">@Model.Customer?.FullName</span></div>
            <div class="stat-line"><span class="k">Plan</span><span class="v">@Model.Plan?.Name</span></div>
            <div class="stat-line"><span class="k">Service</span><span class="v">@Model.Plan?.Category?.Name</span></div>
            <div class="stat-line"><span class="k">Connections</span><span class="v">@Model.Quantity</span></div>
            <div class="stat-line"><span class="k">City</span><span class="v">@Model.City?.Name</span></div>
            <div class="stat-line"><span class="k">Address</span><span class="v">@Model.InstallationAddress</span></div>
            <div class="stat-line"><span class="k">Contact</span><span class="v">@Model.ContactNumber</span></div>
            <div class="stat-line"><span class="k">Source</span><span class="v">@(Model.RetailShopId.HasValue ? Model.RetailShop?.Name ?? "Counter" : "Online")</span></div>
            <div class="stat-line"><span class="k">Placed</span><span class="v">@Model.PlacedAt.ToString("dd MMM yyyy, hh:mm tt")</span></div>
            @if (Model.RequiresLandline)
            {
                <div class="stat-line"><span class="k">Landline</span><span class="v text-gold">New line requested</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.ExistingLandlineAccountId))
            {
                <div class="stat-line"><span class="k">Landline</span><span class="v">@Model.ExistingLandlineAccountId</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="stat-line"><span class="k">Notes</span><span class="v">@Model.Notes</span></div>
            }
        </div>

        <!-- ------------------------------------------------------------- money -->
        <div class="glass p-4 mb-4">
            <h2 class="h5 mb-3">Activation invoice</h2>

            <div class="stat-line"><span class="k">Security deposit</span><span class="v">@Model.SecurityDepositAmount.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">Advance payment</span><span class="v">@Model.AdvanceAmount.ToString("N2")</span></div>
            @if (Model.DiscountPercent > 0)
            {
                <div class="stat-line"><span class="k">Bulk discount</span><span class="v text-gold">@Model.DiscountPercent.ToString("0")%</span></div>
                <div class="stat-line"><span class="k">Deposit payable</span><span class="v">@Model.SecurityDepositPayable.ToString("N2")</span></div>
                <div class="stat-line"><span class="k">Advance payable</span><span class="v">@Model.AdvancePayable.ToString("N2")</span></div>
            }
            <div class="stat-line"><span class="k">Equipment</span><span class="v">@Model.EquipmentAmount.ToString("N2")</span></div>
            <div class="stat-line"><span class="k">Tax (@Model.TaxPercent.ToString("0.##")%)</span><span class="v">@Model.TaxAmount.ToString("N2")</span></div>
            <div class="stat-line stat-total"><span class="k">Total</span><span class="v text-gold fs-5">@Model.TotalAmount.ToString("N2")</span></div>
        </div>

        <!-- ------------------------------------------------------------- cancel -->
        @if (canCancel && Model.Status != OrderStatus.ConnectionProvided && Model.Status != OrderStatus.Cancelled)
        {
            <div class="glass p-4">
                <h2 class="h5 mb-3">Cancel this order</h2>
                <form method="post" asp-area="Vendor" asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.OrderId"
                      data-confirm="Cancel this order? The customer will see the reason.">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <label class="form-label" for="cancelReason">Reason</label>
                    <textarea class="form-control mb-3" id="cancelReason" name="reason" rows="3"
                              placeholder="The address is outside our coverage area." required></textarea>
                    <button class="btn btn-danger-soft w-100" type="submit">
                        <i class="bi bi-x-octagon me-1"></i>Cancel the order
                    </button>
                </form>
            </div>
        }
    </div>
</div>
