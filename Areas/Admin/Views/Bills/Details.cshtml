@model Bill
@{
    ViewData["Title"] = Model.BillNumber;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="glass p-4 mb-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <div class="eyebrow">@Model.BillType.ToDisplayName()</div>
                    <h2 class="h4 mb-1"><span class="order-id-chip">@Model.BillNumber</span></h2>
                    <p class="text-muted-silver fs-14 mb-0">
                        @Model.Connection?.AccountId - @Model.Connection?.Customer?.FullName
                    </p>
                </div>
                @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(Model.Status))
            </div>

            <div class="stat-line"><span class="k">Partner</span><span class="v">@(Model.Connection?.Vendor?.BusinessName ?? "-")</span></div>
            <div class="stat-line"><span class="k">Period</span><span class="v">@Model.PeriodStart.ToString("dd MMM yyyy") - @Model.PeriodEnd.ToString("dd MMM yyyy")</span></div>
            <div class="stat-line"><span class="k">Generated on</span><span class="v">@Model.GeneratedOn.ToString("dd MMM yyyy")</span></div>
            <div class="stat-line"><span class="k">Generated by</span><span class="v">@(Model.GeneratedByName ?? "-")</span></div>
            <div class="stat-line"><span class="k">Due date</span><span class="v">@Model.DueDate.ToString("dd MMM yyyy")</span></div>
        </div>

        <div class="glass p-4">
            <h3 class="h6 mb-3">The charges</h3>
            <div class="table-wrap">
                <table class="table-glass">
                    <thead>
                        <tr><th>Description</th><th class="num">Quantity</th><th class="num">Unit price</th><th class="num">Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td class="text-silver">@line.Description</td>
                                <td class="num text-muted-silver">@line.Quantity.ToString("N2")</td>
                                <td class="num text-muted-silver">@line.UnitPrice.ToString("N2")</td>
                                <td class="num text-silver">@line.Amount.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.Lines.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted-silver fs-14">No line was stored for this bill.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">Sub total</td>
                            <td class="num">@Model.SubTotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">Tax (@Model.TaxPercent.ToString("N2") %)</td>
                            <td class="num">@Model.TaxAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">Total</td>
                            <td class="num text-gold">@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4 mb-4">
            <h3 class="h6 mb-3">The money</h3>
            <div class="stat-line"><span class="k">Plan charge</span><span class="v">@Model.PlanCharge.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Local calls</span><span class="v">@Model.LocalChargeAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">STD calls</span><span class="v">@Model.StdChargeAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Mobile messages</span><span class="v">@Model.MobileChargeAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Replacement</span><span class="v">@Model.ReplacementChargeAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Previous due</span><span class="v">@Model.PreviousDue.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Discount (@Model.DiscountPercent.ToString("N0") %)</span><span class="v">-@Model.DiscountAmount.ToString("N2") Rs</span></div>
            <div class="stat-line stat-total"><span class="k">Amount due</span><span class="v text-gold">@Model.AmountDue.ToString("N2") Rs</span></div>

            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <p class="text-muted-silver fs-14 mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>@Model.Remarks</p>
            }
        </div>

        <div class="glass p-4">
            <h3 class="h6 mb-3">The receipts</h3>
            @if (Model.Payments.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No cash was received for this bill yet.</p>
            }
            else
            {
                <div class="d-grid gap-2">
                    @foreach (var payment in Model.Payments)
                    {
                        <div class="doc-tile">
                            <span class="icon"><i class="bi bi-receipt"></i></span>
                            <div class="flex-grow-1">
                                <div class="text-silver fw-600">@payment.ReceiptNumber</div>
                                <small class="text-muted-silver">
                                    @payment.PaidOn.ToString("dd MMM yyyy") - @(payment.ReceivedByName ?? "-")
                                </small>
                            </div>
                            <span class="text-gold">@payment.Amount.ToString("N2")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
