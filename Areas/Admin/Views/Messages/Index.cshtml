@model List<ContactMessage>
@{
    ViewData["Title"] = "Messages";
    var currentState = ViewData["CurrentState"] as string;
    var unreadCount = ViewData["UnreadCount"] as int? ?? 0;
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalRows = ViewData["TotalRows"] as int? ?? 0;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}

<div class="glass p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="kpi-label me-2">State</span>
        <a class="btn btn-sm @(string.IsNullOrEmpty(currentState) ? "btn-gold" : "btn-ghost")"
           asp-area="Admin" asp-controller="Messages" asp-action="Index">All</a>
        <a class="btn btn-sm @(currentState == "unread" ? "btn-gold" : "btn-ghost")"
           asp-area="Admin" asp-controller="Messages" asp-action="Index" asp-route-state="unread">
            Unread (@unreadCount)
        </a>
        <a class="btn btn-sm @(currentState == "read" ? "btn-gold" : "btn-ghost")"
           asp-area="Admin" asp-controller="Messages" asp-action="Index" asp-route-state="read">Read</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <rect x="35" y="45" width="130" height="80" rx="8" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <path d="M35 50l65 45 65-45" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
        </svg>
        <div class="title">The inbox is empty</div>
        <p class="text">No message matches the current filter.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Sender</th>
                    <th>Contact</th>
                    <th>Received</th>
                    <th>State</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Model)
                {
                    <tr>
                        <td class="text-silver fw-600">@(message.Subject ?? "Without a subject")</td>
                        <td class="fs-14">@message.Name</td>
                        <td class="fs-14 text-muted-silver">
                            @(message.Email ?? "-")
                            @if (!string.IsNullOrWhiteSpace(message.Phone))
                            {
                                <div>@message.Phone</div>
                            }
                        </td>
                        <td class="fs-14">@message.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (message.IsRead)
                            {
                                <span class="badge-status badge-muted">Read</span>
                            }
                            else
                            {
                                <span class="badge-status badge-warning">Unread</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Messages" asp-action="Details" asp-route-id="@message.Id">Open</a>
                                <form method="post" asp-area="Admin" asp-controller="Messages" asp-action="Delete" asp-route-id="@message.Id"
                                      data-confirm="Delete this message?">
                                    <button class="btn btn-ghost btn-sm" type="submit"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = page,
        TotalPages = totalPages,
        TotalRows = totalRows,
        RouteValues = new Dictionary<string, string?>
        {
            ["state"] = currentState
        }
    })
}
