@model ContactMessage
@{
    ViewData["Title"] = Model.Subject ?? "Message";
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="glass p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <div class="eyebrow">Message of the contact form</div>
                    <h2 class="h4 mb-1">@(Model.Subject ?? "Without a subject")</h2>
                    <p class="text-muted-silver fs-14 mb-0">Received on @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                </div>
                @if (Model.IsRead)
                {
                    <span class="badge-status badge-muted">Read</span>
                }
                else
                {
                    <span class="badge-status badge-warning">Unread</span>
                }
            </div>

            <p class="text-silver fs-14" style="white-space:pre-line;">@Model.Message</p>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4 mb-4">
            <h3 class="h6 mb-3">The sender</h3>
            <div class="stat-line"><span class="k">Name</span><span class="v">@Model.Name</span></div>
            <div class="stat-line"><span class="k">Email</span><span class="v">@(Model.Email ?? "-")</span></div>
            <div class="stat-line"><span class="k">Phone</span><span class="v">@(Model.Phone ?? "-")</span></div>
            <div class="stat-line stat-total"><span class="k">Received</span><span class="v">@Model.CreatedAt.ToString("dd MMM yyyy")</span></div>
        </div>

        <div class="glass p-4">
            <div class="d-grid gap-2">
                <form method="post" asp-area="Admin" asp-controller="Messages" asp-action="ToggleRead" asp-route-id="@Model.Id">
                    <button class="btn btn-ghost w-100" type="submit">
                        <i class="bi bi-envelope me-1"></i>Mark as @(Model.IsRead ? "unread" : "read")
                    </button>
                </form>
                <form method="post" asp-area="Admin" asp-controller="Messages" asp-action="Delete" asp-route-id="@Model.Id"
                      data-confirm="Delete this message?">
                    <button class="btn btn-danger-soft w-100" type="submit"><i class="bi bi-trash me-1"></i>Delete the message</button>
                </form>
                <a class="btn btn-ghost w-100" asp-area="Admin" asp-controller="Messages" asp-action="Index">Back to the inbox</a>
            </div>
        </div>
    </div>
</div>
