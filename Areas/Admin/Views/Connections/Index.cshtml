@model List<Connection>
@{
    ViewData["Title"] = "Connections";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentType = ViewData["CurrentType"] as string;
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalRows = ViewData["TotalRows"] as int? ?? 0;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}

<div class="glass p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <span class="kpi-label me-2">State</span>
        <a class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-gold" : "btn-ghost")"
           asp-area="Admin" asp-controller="Connections" asp-action="Index">All</a>
        @foreach (var status in Enum.GetValues<ConnectionStatus>())
        {
            <a class="btn btn-sm @(currentStatus == status.ToString() ? "btn-gold" : "btn-ghost")"
               asp-area="Admin" asp-controller="Connections" asp-action="Index" asp-route-status="@status">@status.ToDisplayName()</a>
        }
    </div>

    <form method="get" class="d-flex flex-wrap gap-2">
        <input type="hidden" name="status" value="@currentStatus" />
        <input class="form-control" style="max-width:280px" type="search" name="search" value="@currentSearch"
               placeholder="Account id, customer or order id" />
        <input class="form-control" style="max-width:220px" type="search" name="type" value="@currentType"
               placeholder="Service" />
        <button class="btn btn-outline-gold" type="submit"><i class="bi bi-search me-1"></i>Search</button>
        <a class="btn btn-ghost ms-auto" asp-area="Admin" asp-controller="Connections" asp-action="Export"
           asp-route-search="@currentSearch" asp-route-status="@currentStatus">
            <i class="bi bi-filetype-csv me-1"></i>Export CSV
        </a>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <rect x="55" y="55" width="90" height="55" rx="10" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <path d="M70 55V38h60v17M100 110v22" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
        </svg>
        <div class="title">No connection in this view</div>
        <p class="text">No connection of the network matches the current filter.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Account id</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Partner</th>
                    <th>Activated</th>
                    <th>Status</th>
                    <th class="num">Monthly</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var connection in Model)
                {
                    <tr>
                        <td><span class="account-id-chip">@connection.AccountId</span></td>
                        <td class="fs-14">@connection.Customer?.FullName</td>
                        <td class="fs-14 text-muted-silver">@(connection.Plan?.Name ?? "-")</td>
                        <td class="fs-14 text-muted-silver">@(connection.Vendor?.BusinessName ?? "-")</td>
                        <td class="fs-14">@connection.ActivationDate.ToString("dd MMM yyyy")</td>
                        <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(connection.Status))</td>
                        <td class="num text-silver">@connection.MonthlyCharge.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Connections" asp-action="Details" asp-route-id="@connection.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = page,
        TotalPages = totalPages,
        TotalRows = totalRows,
        RouteValues = new Dictionary<string, string?>
        {
            ["search"] = currentSearch,
            ["status"] = currentStatus,
            ["type"] = currentType
        }
    })
}
