@model List<Order>
@{
    ViewData["Title"] = "Orders";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentVendor = ViewData["CurrentVendor"] as string;
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalRows = ViewData["TotalRows"] as int? ?? 0;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}

<div class="glass p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <span class="kpi-label me-2">State</span>
        <a class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-gold" : "btn-ghost")"
           asp-area="Admin" asp-controller="Orders" asp-action="Index">All</a>
        @foreach (var status in Enum.GetValues<OrderStatus>())
        {
            <a class="btn btn-sm @(currentStatus == status.ToString() ? "btn-gold" : "btn-ghost")"
               asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="@status">@status.ToDisplayName()</a>
        }
    </div>

    <form method="get" class="d-flex flex-wrap gap-2">
        <input type="hidden" name="status" value="@currentStatus" />
        <input class="form-control" style="max-width:280px" type="search" name="search" value="@currentSearch"
               placeholder="Order id, customer or phone number" />
        <input class="form-control" style="max-width:240px" type="search" name="vendor" value="@currentVendor"
               placeholder="Service partner" />
        <button class="btn btn-outline-gold" type="submit"><i class="bi bi-search me-1"></i>Search</button>
        <a class="btn btn-ghost ms-auto" asp-area="Admin" asp-controller="Orders" asp-action="Export"
           asp-route-search="@currentSearch" asp-route-status="@currentStatus" asp-route-vendor="@currentVendor">
            <i class="bi bi-filetype-csv me-1"></i>Export CSV
        </a>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <rect x="45" y="30" width="110" height="100" rx="10" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <path d="M65 60h70M65 80h70M65 100h40" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
        </svg>
        <div class="title">No order in this view</div>
        <p class="text">No order of the network matches the current filter.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Order id</th>
                    <th>Customer</th>
                    <th>Plan</th>
                    <th>Partner</th>
                    <th>Placed</th>
                    <th>Status</th>
                    <th class="num">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><span class="order-id-chip">@order.OrderId</span></td>
                        <td class="fs-14">@order.Customer?.FullName</td>
                        <td class="fs-14 text-muted-silver">@order.Plan?.Name</td>
                        <td class="fs-14 text-muted-silver">@(order.Vendor?.BusinessName ?? "-")</td>
                        <td class="fs-14">@order.PlacedAt.ToString("dd MMM yyyy")</td>
                        <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(order.Status))</td>
                        <td class="num text-silver">@order.TotalAmount.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = page,
        TotalPages = totalPages,
        TotalRows = totalRows,
        RouteValues = new Dictionary<string, string?>
        {
            ["search"] = currentSearch,
            ["status"] = currentStatus,
            ["vendor"] = currentVendor
        }
    })
}
