@model Order
@{
    ViewData["Title"] = $"Order {Model.OrderId}";
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="glass p-4 mb-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <div class="eyebrow">Order</div>
                    <h2 class="h4 mb-1"><span class="order-id-chip">@Model.OrderId</span></h2>
                    <p class="text-muted-silver fs-14 mb-0">
                        @Model.Customer?.FullName - @Model.Plan?.Name
                    </p>
                </div>
                @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(Model.Status))
            </div>

            <div class="stat-line"><span class="k">Type</span><span class="v">@Model.TypeLetter</span></div>
            <div class="stat-line"><span class="k">Partner</span><span class="v">@(Model.Vendor?.BusinessName ?? "-")</span></div>
            <div class="stat-line"><span class="k">Counter</span><span class="v">@(Model.RetailShop?.Name ?? "Online")</span></div>
            <div class="stat-line"><span class="k">City</span><span class="v">@(Model.City?.Name ?? "-")</span></div>
            <div class="stat-line"><span class="k">Placed</span><span class="v">@Model.PlacedAt.ToString("dd MMM yyyy HH:mm")</span></div>
            <div class="stat-line"><span class="k">Connections</span><span class="v">@Model.Quantity</span></div>
            <div class="stat-line"><span class="k">Device</span><span class="v">@(Model.EquipmentProduct?.Name ?? "Without a device")</span></div>
        </div>

        <div class="glass p-4 mb-4">
            <h3 class="h6 mb-3">The money</h3>
            <div class="stat-line"><span class="k">Security deposit</span><span class="v">@Model.SecurityDepositAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Advance payment</span><span class="v">@Model.AdvanceAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Equipment</span><span class="v">@Model.EquipmentAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Bulk discount</span><span class="v">@Model.DiscountPercent.ToString("N0") %</span></div>
            <div class="stat-line"><span class="k">Tax (@Model.TaxPercent.ToString("N2") %)</span><span class="v">@Model.TaxAmount.ToString("N2") Rs</span></div>
            <div class="stat-line stat-total"><span class="k">Total</span><span class="v text-gold">@Model.TotalAmount.ToString("N2") Rs</span></div>
            <p class="text-muted-silver fs-14 mt-2 mb-0"><i class="bi bi-cash-coin me-1"></i>@Model.PaymentMethod</p>
        </div>

        @if (Model.Connections.Count > 0)
        {
            <div class="glass p-4">
                <h3 class="h6 mb-3">The connections of the order</h3>
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr><th>Account id</th><th>Activated</th><th>Status</th><th class="num">Monthly</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var connection in Model.Connections)
                            {
                                <tr>
                                    <td><span class="account-id-chip">@connection.AccountId</span></td>
                                    <td class="fs-14">@connection.ActivationDate.ToString("dd MMM yyyy")</td>
                                    <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(connection.Status))</td>
                                    <td class="num text-silver">@connection.MonthlyCharge.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="glass p-4 mb-4">
            <h3 class="h6 mb-3">The timeline of the order</h3>
            @if (Model.StatusHistory.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No step was recorded yet.</p>
            }
            else
            {
                <ul class="timeline">
                    @foreach (var step in Model.StatusHistory.OrderBy(s => s.ChangedAt))
                    {
                        <li class="timeline-item">
                            <span class="timeline-dot done"></span>
                            <div class="timeline-title">@step.ToStatus.ToDisplayName()</div>
                            <div class="timeline-meta">
                                @step.ChangedAt.ToString("dd MMM yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(step.ChangedByName))
                                {
                                    <span> - @step.ChangedByName</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(step.Remark))
                            {
                                <div class="text-muted-silver fs-14">@step.Remark</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="glass p-4">
            <h3 class="h6 mb-3">The feasibility checks</h3>
            @if (Model.FeasibilityChecks.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No survey was recorded for this order.</p>
            }
            else
            {
                <div class="d-grid gap-2">
                    @foreach (var check in Model.FeasibilityChecks)
                    {
                        <div class="doc-tile">
                            <span class="icon"><i class="bi bi-clipboard2-pulse"></i></span>
                            <div class="flex-grow-1">
                                <div class="text-silver fw-600">@check.CheckType.ToDisplayName()</div>
                                <small class="text-muted-silver">@(check.Remarks ?? check.ServerAvailability ?? "-")</small>
                            </div>
                            @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(check.Result))
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
