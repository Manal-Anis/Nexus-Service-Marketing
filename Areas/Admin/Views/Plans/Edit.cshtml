@model PlanFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="row g-4">
    <div class="col-lg-8">
        <form method="post" asp-area="Admin" asp-controller="Plans" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">The plan</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="CategoryId"></label>
                        <select asp-for="CategoryId" asp-items="@(Model.Categories.Select(c => new SelectListItem { Text = c.Name, Value = c.Id.ToString() }))" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Kind"></label>
                        <select asp-for="Kind" asp-items="@(Html.GetEnumSelectList<PlanKind>())" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="BillingPeriod"></label>
                        <select asp-for="BillingPeriod" asp-items="@(Html.GetEnumSelectList<BillingPeriod>())" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Hours"></label>
                        <input asp-for="Hours" class="form-control" type="number" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="SpeedKbps"></label>
                        <input asp-for="SpeedKbps" class="form-control" type="number" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="ValidityDays"></label>
                        <input asp-for="ValidityDays" class="form-control" type="number" min="0" />
                    </div>
                </div>
            </div>

            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">The charges</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Price"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="LocalRate"></label>
                        <input asp-for="LocalRate" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="StdRate"></label>
                        <input asp-for="StdRate" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="MobileMsgRate"></label>
                        <input asp-for="MobileMsgRate" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Description"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Features"></label>
                        <textarea asp-for="Features" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label" asp-for="IsActive">The plan is offered to the customers</label>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-gold" type="submit"><i class="bi bi-check2-circle me-1"></i>Save the changes</button>
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Plans" asp-action="Index">Cancel</a>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4">
            <h2 class="h6 mb-3">Note</h2>
            <p class="text-muted-silver fs-14 mb-0">
                The price of a plan is used by the order wizard and by the billing of the periodic
                bills. A change is written into the audit log.
            </p>
        </div>
    </div>
</div>
