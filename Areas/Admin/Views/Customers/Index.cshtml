@model List<Customer>
@{
    ViewData["Title"] = "Customers";
    var cities = ViewData["Cities"] as List<City> ?? new List<City>();
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentCity = ViewData["CurrentCity"] as string;
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalRows = ViewData["TotalRows"] as int? ?? 0;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}

<div class="glass p-3 mb-4">
    <form method="get" class="d-flex flex-wrap gap-2">
        <input class="form-control" style="max-width:300px" type="search" name="search" value="@currentSearch"
               placeholder="Name, email or phone number" />
        <select name="city" class="form-select" style="max-width:220px">
            <option value="">Every city</option>
            @foreach (var item in cities)
            {
                <option value="@item.Name" selected="@(currentCity == item.Name)">@item.Name</option>
            }
        </select>
        <button class="btn btn-outline-gold" type="submit"><i class="bi bi-search me-1"></i>Search</button>
        @if (!string.IsNullOrWhiteSpace(currentSearch) || !string.IsNullOrWhiteSpace(currentCity))
        {
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Customers" asp-action="Index">Clear</a>
        }
        <a class="btn btn-ghost ms-auto" asp-area="Admin" asp-controller="Customers" asp-action="Export"
           asp-route-search="@currentSearch" asp-route-city="@currentCity">
            <i class="bi bi-filetype-csv me-1"></i>Export CSV
        </a>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <circle cx="80" cy="62" r="22" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <circle cx="128" cy="72" r="17" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
            <path d="M42 132c6-22 22-32 38-32s32 10 38 32M104 132c4-16 14-24 26-24s22 8 26 24" stroke="#c9ccd3" stroke-width="2" opacity=".35" />
        </svg>
        <div class="title">No customer in this view</div>
        <p class="text">No customer of the network matches the current filter.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Contact</th>
                    <th>City</th>
                    <th class="num">Orders</th>
                    <th class="num">Connections</th>
                    <th>Registered</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td class="text-silver fw-600">@customer.FullName</td>
                        <td class="fs-14 text-muted-silver">
                            @(customer.Phone ?? "-")
                            @if (!string.IsNullOrWhiteSpace(customer.Email))
                            {
                                <div>@customer.Email</div>
                            }
                        </td>
                        <td class="fs-14">@(customer.City?.Name ?? "-")</td>
                        <td class="num">@customer.Orders.Count</td>
                        <td class="num">@customer.Connections.Count</td>
                        <td class="fs-14 text-muted-silver">@customer.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = page,
        TotalPages = totalPages,
        TotalRows = totalRows,
        RouteValues = new Dictionary<string, string?>
        {
            ["search"] = currentSearch,
            ["city"] = currentCity
        }
    })
}
