@model Customer
@{
    ViewData["Title"] = Model.FullName;
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="glass p-4 mb-4">
            <div class="eyebrow">Customer</div>
            <h2 class="h4 mb-3">@Model.FullName</h2>

            <div class="stat-line"><span class="k">Phone</span><span class="v">@(Model.Phone ?? "-")</span></div>
            <div class="stat-line"><span class="k">Email</span><span class="v">@(Model.Email ?? "-")</span></div>
            <div class="stat-line"><span class="k">City</span><span class="v">@(Model.City?.Name ?? "-")</span></div>
            <div class="stat-line"><span class="k">Address</span><span class="v">@(Model.Address ?? "-")</span></div>
            <div class="stat-line"><span class="k">Identity proof</span><span class="v">@(Model.IdProofType ?? "-")</span></div>
            <div class="stat-line stat-total"><span class="k">Registered</span><span class="v">@Model.CreatedAt.ToString("dd MMM yyyy")</span></div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="glass p-4 mb-4">
            <h3 class="h6 mb-3">The orders</h3>
            @if (Model.Orders.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">This customer has not placed an order yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr><th>Order id</th><th>Plan</th><th>Placed</th><th>Status</th><th class="num">Total</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td><span class="order-id-chip">@order.OrderId</span></td>
                                    <td class="fs-14">@(order.Plan?.Name ?? "-")</td>
                                    <td class="fs-14 text-muted-silver">@order.PlacedAt.ToString("dd MMM yyyy")</td>
                                    <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(order.Status))</td>
                                    <td class="num text-silver">@order.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="glass p-4">
            <h3 class="h6 mb-3">The connections</h3>
            @if (Model.Connections.Count == 0)
            {
                <p class="text-muted-silver fs-14 mb-0">No connection of this customer is active yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-glass">
                        <thead>
                            <tr><th>Account id</th><th>Plan</th><th>Activated</th><th>Status</th><th class="num">Monthly</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var connection in Model.Connections)
                            {
                                <tr>
                                    <td><span class="account-id-chip">@connection.AccountId</span></td>
                                    <td class="fs-14">@(connection.Plan?.Name ?? "-")</td>
                                    <td class="fs-14 text-muted-silver">@connection.ActivationDate.ToString("dd MMM yyyy")</td>
                                    <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(connection.Status))</td>
                                    <td class="num text-silver">@connection.MonthlyCharge.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
