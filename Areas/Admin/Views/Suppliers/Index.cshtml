@model List<Supplier>
@{
    ViewData["Title"] = "Suppliers";
    var currentSearch = ViewData["CurrentSearch"] as string;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}

<div class="glass p-3 mb-4">
    <form method="get" class="d-flex flex-wrap gap-2">
        <input class="form-control" style="max-width:320px" type="search" name="search" value="@currentSearch"
               placeholder="Name or contact person" />
        <button class="btn btn-outline-gold" type="submit"><i class="bi bi-search me-1"></i>Search</button>
        <a class="btn btn-gold ms-auto" asp-area="Admin" asp-controller="Suppliers" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>Register a supplier
        </a>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <path d="M30 45h100v70H30zM130 70h25l15 25v20h-40z" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <circle cx="60" cy="120" r="12" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
            <circle cx="145" cy="120" r="12" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
        </svg>
        <div class="title">No supplier yet</div>
        <p class="text">Register the first company that delivers the equipment.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Contact person</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>City</th>
                    <th class="num">Devices</th>
                    <th>State</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td class="text-silver fw-600">@supplier.Name</td>
                        <td class="fs-14">@(supplier.ContactName ?? "-")</td>
                        <td class="fs-14 text-muted-silver">@(supplier.Phone ?? "-")</td>
                        <td class="fs-14 text-muted-silver">@(supplier.Email ?? "-")</td>
                        <td class="fs-14 text-muted-silver">@(supplier.City?.Name ?? "-")</td>
                        <td class="num">@supplier.Products.Count</td>
                        <td>
                            @if (supplier.IsActive)
                            {
                                <span class="badge-status badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-status badge-muted">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Suppliers" asp-action="Edit" asp-route-id="@supplier.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
