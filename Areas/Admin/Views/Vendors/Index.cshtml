@model List<Vendor>
@{
    ViewData["Title"] = "Service partners";
    var currentStatus = ViewData["CurrentStatus"] as string;
    var currentSearch = ViewData["CurrentSearch"] as string;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}
@if (TempData["Credentials"] is string credentials && !string.IsNullOrWhiteSpace(credentials))
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-key-fill"></i><div><strong>Login details (shown once):</strong> @credentials</div></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-nexus alert-danger mb-4"><i class="bi bi-x-circle-fill"></i><div>@error</div></div>
}

<div class="glass p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <span class="kpi-label me-2">State</span>
        <a class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-gold" : "btn-ghost")"
           asp-area="Admin" asp-controller="Vendors" asp-action="Index">All</a>
        @foreach (var status in Enum.GetValues<VendorStatus>())
        {
            <a class="btn btn-sm @(currentStatus == status.ToString() ? "btn-gold" : "btn-ghost")"
               asp-area="Admin" asp-controller="Vendors" asp-action="Index" asp-route-status="@status">@status.ToDisplayName()</a>
        }
    </div>

    <form method="get" class="d-flex flex-wrap gap-2">
        <input type="hidden" name="status" value="@currentStatus" />
        <input class="form-control" style="max-width:320px" type="search" name="search" value="@currentSearch"
               placeholder="Business name, owner or email address" />
        <button class="btn btn-outline-gold" type="submit"><i class="bi bi-search me-1"></i>Search</button>
        @if (!string.IsNullOrWhiteSpace(currentSearch))
        {
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Vendors" asp-action="Index" asp-route-status="@currentStatus">Clear</a>
        }
        <a class="btn btn-gold ms-auto" asp-area="Admin" asp-controller="Vendors" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>Register a partner
        </a>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <path d="M40 70h120v60H40z" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <path d="M60 70V50h80v20" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
        </svg>
        <div class="title">No partner in this view</div>
        <p class="text">No service partner matches the current filter.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Partner</th>
                    <th>Owner</th>
                    <th>City</th>
                    <th>Contact</th>
                    <th>Shops</th>
                    <th>State</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vendor in Model)
                {
                    <tr>
                        <td class="text-silver fw-600">@vendor.BusinessName</td>
                        <td class="fs-14">@vendor.OwnerName</td>
                        <td class="fs-14 text-muted-silver">@(vendor.City?.Name ?? "-")</td>
                        <td class="fs-14 text-muted-silver">
                            @vendor.Phone
                            @if (!string.IsNullOrWhiteSpace(vendor.Email))
                            {
                                <div class="fs-14">@vendor.Email</div>
                            }
                        </td>
                        <td class="num">@vendor.RetailShops.Count</td>
                        <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(vendor.Status))</td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Vendors" asp-action="Details" asp-route-id="@vendor.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
