@model VendorFormViewModel
@{
    ViewData["Title"] = "Register a partner";
}

<div class="row g-4">
    <div class="col-lg-8">
        <form method="post" asp-area="Admin" asp-controller="Vendors" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">The partner</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="BusinessName"></label>
                        <input asp-for="BusinessName" class="form-control" placeholder="Nexus Telecom Karachi" />
                        <span asp-validation-for="BusinessName" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="OwnerName"></label>
                        <input asp-for="OwnerName" class="form-control" />
                        <span asp-validation-for="OwnerName" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Phone"></label>
                        <input asp-for="Phone" class="form-control" placeholder="0300-1234567" />
                        <span asp-validation-for="Phone" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="CityId"></label>
                        <select asp-for="CityId" asp-items="@(Model.Cities.Select(c => new SelectListItem { Text = $"{c.Name} ({c.Code3})", Value = c.Id.ToString() }))" class="form-select">
                            <option value="">Select a city</option>
                        </select>
                        <span asp-validation-for="CityId" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Status"></label>
                        <select asp-for="Status" asp-items="@(Html.GetEnumSelectList<VendorStatus>())" class="form-select"></select>
                        <span asp-validation-for="Status" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Address"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="StatusRemarks"></label>
                        <input asp-for="StatusRemarks" class="form-control" placeholder="Why the partner was approved or rejected" />
                    </div>
                </div>
            </div>

            <button class="btn btn-gold" type="submit"><i class="bi bi-check2-circle me-1"></i>Register the partner</button>
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Vendors" asp-action="Index">Cancel</a>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4">
            <h2 class="h6 mb-3">Note</h2>
            <p class="text-muted-silver fs-14 mb-0">
                A partner receives its own login through the employee screen. The customers that walk
                into the counter are registered by the retail staff of the partner.
            </p>
        </div>
    </div>
</div>
