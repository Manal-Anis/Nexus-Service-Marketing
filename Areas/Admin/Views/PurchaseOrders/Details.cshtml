@model PurchaseOrder
@{
    ViewData["Title"] = Model.PurchaseOrderNumber;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-nexus alert-danger mb-4"><i class="bi bi-x-circle-fill"></i><div>@error</div></div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="glass p-4 mb-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <div class="eyebrow">Purchase order</div>
                    <h2 class="h4 mb-1">@Model.PurchaseOrderNumber</h2>
                    <p class="text-muted-silver fs-14 mb-0">@Model.Supplier?.Name</p>
                </div>
                <div class="d-flex gap-2">
                    @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(Model.Status))
                    @await Component.InvokeAsync("StatusBadge", BadgeMapper.For(Model.PaymentStatus))
                </div>
            </div>

            <div class="stat-line"><span class="k">Order date</span><span class="v">@Model.OrderDate.ToString("dd MMM yyyy")</span></div>
            <div class="stat-line"><span class="k">Expected delivery</span><span class="v">@(Model.ExpectedDate?.ToString("dd MMM yyyy") ?? "-")</span></div>
            <div class="stat-line"><span class="k">Received on</span><span class="v">@(Model.ReceivedOn?.ToString("dd MMM yyyy") ?? "-")</span></div>
            <div class="stat-line"><span class="k">Total</span><span class="v">@Model.TotalAmount.ToString("N2") Rs</span></div>
            <div class="stat-line"><span class="k">Paid</span><span class="v">@Model.AmountPaid.ToString("N2") Rs</span></div>
            <div class="stat-line stat-total"><span class="k">Due</span><span class="v text-gold">@Model.AmountDue.ToString("N2") Rs</span></div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <p class="text-muted-silver fs-14 mt-3 mb-0">@Model.Notes</p>
            }
        </div>

        <div class="glass p-4">
            <h3 class="h6 mb-3">The lines</h3>
            <div class="table-wrap">
                <table class="table-glass">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th class="num">Quantity</th>
                            <th class="num">Unit cost</th>
                            <th class="num">Line total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-silver">@(item.Product?.Name ?? "-")</td>
                                <td class="num">@item.Quantity</td>
                                <td class="num text-muted-silver">@item.UnitCost.ToString("N2")</td>
                                <td class="num text-silver">@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">Total</td>
                            <td class="num text-gold">@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4 mb-4">
            <h3 class="h6 mb-3">The workflow</h3>

            @if (Model.Status == PurchaseOrderStatus.Draft)
            {
                <form method="post" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Place" asp-route-id="@Model.Id"
                      data-confirm="Send this order to the supplier?">
                    <button class="btn btn-gold w-100" type="submit"><i class="bi bi-send me-1"></i>Place the order</button>
                </form>
            }

            @if (Model.Status == PurchaseOrderStatus.Placed)
            {
                <form method="post" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Receive" asp-route-id="@Model.Id"
                      data-confirm="The goods arrived? The stock of the store room grows now.">
                    <button class="btn btn-gold w-100" type="submit"><i class="bi bi-box-arrow-in-down me-1"></i>Receive the goods</button>
                </form>
            }

            @if (Model.Status == PurchaseOrderStatus.Received)
            {
                <p class="text-muted-silver fs-14 mb-0">
                    <i class="bi bi-check-circle me-1"></i>The goods were received and the stock was increased.
                </p>
            }
        </div>

        <div class="glass p-4">
            <h3 class="h6 mb-3">The payment to the supplier</h3>

            <form method="post" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Pay" asp-route-id="@Model.Id" class="d-grid gap-2">
                <label class="form-label" for="amount">Amount that was paid</label>
                <input id="amount" name="amount" class="form-control" type="number" step="0.01" min="0.01" value="@Model.AmountDue.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <button class="btn btn-outline-gold" type="submit"><i class="bi bi-cash-coin me-1"></i>Record the payment</button>
            </form>

            <div class="stat-line mt-3"><span class="k">Already paid</span><span class="v">@Model.AmountPaid.ToString("N2") Rs</span></div>
            <div class="stat-line stat-total"><span class="k">Still owed</span><span class="v text-gold">@Model.AmountDue.ToString("N2") Rs</span></div>
        </div>
    </div>
</div>
