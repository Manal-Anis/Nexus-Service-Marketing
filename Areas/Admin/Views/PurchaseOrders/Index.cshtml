@model List<PurchaseOrder>
@{
    ViewData["Title"] = "Purchase orders";
    var currentStatus = ViewData["CurrentStatus"] as PurchaseOrderStatus?;
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-nexus alert-danger mb-4"><i class="bi bi-x-circle-fill"></i><div>@error</div></div>
}

<div class="glass p-3 mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <span class="kpi-label me-2">State</span>
        <a class="btn btn-sm @(currentStatus is null ? "btn-gold" : "btn-ghost")"
           asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Index">All</a>
        @foreach (var status in Enum.GetValues<PurchaseOrderStatus>())
        {
            <a class="btn btn-sm @(currentStatus == status ? "btn-gold" : "btn-ghost")"
               asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Index" asp-route-status="@status">@status.ToDisplayName()</a>
        }
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-gold" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>Raise a purchase order
        </a>
        <a class="btn btn-ghost" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Reorder">
            <i class="bi bi-cart-plus me-1"></i>Reorder suggestion
        </a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <path d="M45 45h110v85H45z" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <path d="M45 65h110M80 85h40M80 105h25" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
        </svg>
        <div class="title">No purchase order in this view</div>
        <p class="text">No purchase order of the store room matches the current filter.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Number</th>
                    <th>Supplier</th>
                    <th>Ordered</th>
                    <th>Expected</th>
                    <th class="num">Lines</th>
                    <th class="num">Total</th>
                    <th>Payment</th>
                    <th>State</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><span class="order-id-chip">@order.PurchaseOrderNumber</span></td>
                        <td class="fs-14">@(order.Supplier?.Name ?? "-")</td>
                        <td class="fs-14">@order.OrderDate.ToString("dd MMM yyyy")</td>
                        <td class="fs-14 text-muted-silver">@(order.ExpectedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td class="num">@order.Items.Count</td>
                        <td class="num text-silver">@order.TotalAmount.ToString("N2")</td>
                        <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(order.PaymentStatus))</td>
                        <td>@await Component.InvokeAsync("StatusBadge", BadgeMapper.For(order.Status))</td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@order.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
