@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Register an employee";
}

<div class="row g-4">
    <div class="col-lg-8">
        <form method="post" asp-area="Admin" asp-controller="Employees" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">The employee</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="FullName"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Phone"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="NationalId"></label>
                        <input asp-for="NationalId" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="JoiningDate"></label>
                        <input asp-for="JoiningDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Designation"></label>
                        <input asp-for="Designation" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">The access</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="VendorId"></label>
                        <select asp-for="VendorId" asp-items="@(Model.Vendors.Select(v => new SelectListItem { Text = v.BusinessName, Value = v.Id.ToString() }))" class="form-select">
                            <option value="">Select a partner</option>
                        </select>
                        <span asp-validation-for="VendorId" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="RetailShopId"></label>
                        <select asp-for="RetailShopId" asp-items="@(Model.Shops.Select(s => new SelectListItem { Text = s.Name, Value = s.Id.ToString() }))" class="form-select">
                            <option value="">No specific counter</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="EmployeeType"></label>
                        <select asp-for="EmployeeType" asp-items="@(Html.GetEnumSelectList<EmployeeType>())" class="form-select"></select>
                        <span asp-validation-for="EmployeeType" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label" asp-for="IsActive">The employee may sign in right away</label>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-gold" type="submit"><i class="bi bi-check2-circle me-1"></i>Register the employee</button>
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Employees" asp-action="Index">Cancel</a>
        </form>
    </div>

    <div class="col-lg-4">
        <div class="glass p-4">
            <h2 class="h6 mb-3">The departments</h2>
            <ul class="timeline">
                <li class="timeline-item">
                    <span class="timeline-dot done"></span>
                    <div class="timeline-title">Manager</div>
                    <div class="timeline-meta">Opens every tab of the partner dashboard</div>
                </li>
                <li class="timeline-item">
                    <span class="timeline-dot done"></span>
                    <div class="timeline-title">Retail</div>
                    <div class="timeline-meta">Takes the orders and collects the cash at the counter</div>
                </li>
                <li class="timeline-item">
                    <span class="timeline-dot done"></span>
                    <div class="timeline-title">Technical</div>
                    <div class="timeline-meta">Records the survey and provides the connections</div>
                </li>
                <li class="timeline-item">
                    <span class="timeline-dot done"></span>
                    <div class="timeline-title">Accounts</div>
                    <div class="timeline-meta">Raises the bills and records the receipts</div>
                </li>
            </ul>
        </div>
    </div>
</div>
