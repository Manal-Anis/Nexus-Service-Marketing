@model List<AuditLog>
@{
    ViewData["Title"] = "Audit log";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentAction = ViewData["CurrentAction"] as string;
    var page = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalRows = ViewData["TotalRows"] as int? ?? 0;
}

<div class="glass p-3 mb-4">
    <form method="get" class="d-flex flex-wrap gap-2">
        <input class="form-control" style="max-width:280px" type="search" name="search" value="@currentSearch"
               placeholder="User, record or details" />
        <input class="form-control" style="max-width:220px" type="search" name="action" value="@currentAction"
               placeholder="Action, for example Bill." />
        <button class="btn btn-outline-gold" type="submit"><i class="bi bi-search me-1"></i>Search</button>
        <a class="btn btn-ghost ms-auto" asp-area="Admin" asp-controller="Audit" asp-action="Export"
           asp-route-search="@currentSearch" asp-route-action="@currentAction">
            <i class="bi bi-filetype-csv me-1"></i>Export CSV
        </a>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <path d="M100 35l50 20v35c0 30-22 45-50 55-28-10-50-25-50-55V55z" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <path d="M80 80l14 14 28-30" stroke="#c9ccd3" stroke-width="2" opacity=".45" />
        </svg>
        <div class="title">No entry in the audit log</div>
        <p class="text">No action matches the current filter.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Record</th>
                    <th>Details</th>
                    <th>Ip address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td class="fs-14 nowrap">@entry.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="fs-14 text-silver">@(entry.UserName ?? "-")</td>
                        <td><span class="badge-status badge-info">@entry.Action</span></td>
                        <td class="fs-14 text-muted-silver">
                            @(entry.EntityType ?? "-")
                            @if (!string.IsNullOrWhiteSpace(entry.EntityId))
                            {
                                <span>#@entry.EntityId</span>
                            }
                        </td>
                        <td class="fs-14 text-muted-silver">@(entry.Details ?? "-")</td>
                        <td class="fs-14 text-muted-silver">@(entry.IpAddress ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel
    {
        Page = page,
        TotalPages = totalPages,
        TotalRows = totalRows,
        RouteValues = new Dictionary<string, string?>
        {
            ["search"] = currentSearch,
            ["action"] = currentAction
        }
    })
}
