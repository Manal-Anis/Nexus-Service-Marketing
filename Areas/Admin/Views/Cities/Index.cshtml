@model List<City>
@{
    ViewData["Title"] = "Cities";
}

@if (TempData["Success"] is string success)
{
    <div class="alert-nexus alert-success mb-4"><i class="bi bi-check-circle-fill"></i><div>@success</div></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-nexus alert-danger mb-4"><i class="bi bi-x-circle-fill"></i><div>@error</div></div>
}

<div class="glass p-3 mb-4 d-flex justify-content-between align-items-center">
    <p class="text-muted-silver fs-14 mb-0">
        The three digit code of the city becomes the second part of every sixteen character account
        number, for example <span class="account-id-chip">B001000000000001</span>.
    </p>
    <a class="btn btn-gold" asp-area="Admin" asp-controller="Cities" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i>Register a city
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="glass empty-state">
        <svg viewBox="0 0 200 160" fill="none" aria-hidden="true">
            <path d="M100 40c-22 0-40 18-40 40 0 28 40 56 40 56s40-28 40-56c0-22-18-40-40-40z" stroke="#d4af37" stroke-width="2" opacity=".5" />
            <circle cx="100" cy="80" r="13" stroke="#c9ccd3" stroke-width="2" opacity=".4" />
        </svg>
        <div class="title">No city yet</div>
        <p class="text">Register the first city of the network.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table-glass">
            <thead>
                <tr>
                    <th>City</th>
                    <th>Code</th>
                    <th>Customers</th>
                    <th>State</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var city in Model)
                {
                    <tr>
                        <td class="text-silver fw-600">@city.Name</td>
                        <td><span class="order-id-chip">@city.Code3</span></td>
                        <td class="num">@city.Customers.Count</td>
                        <td>
                            @if (city.IsActive)
                            {
                                <span class="badge-status badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-status badge-muted">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Cities" asp-action="Edit" asp-route-id="@city.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
