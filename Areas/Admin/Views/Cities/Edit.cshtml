@model CityFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" asp-area="Admin" asp-controller="Cities" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">The city</h2>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label" asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" asp-for="Code3"></label>
                        <input asp-for="Code3" class="form-control" maxlength="3" />
                        <span asp-validation-for="Code3" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label" asp-for="IsActive">The city is served by the network</label>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-gold" type="submit"><i class="bi bi-check2-circle me-1"></i>Save the changes</button>
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Cities" asp-action="Index">Cancel</a>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="glass p-4">
            <h2 class="h6 mb-3">Careful</h2>
            <p class="text-muted-silver fs-14 mb-0">
                Changing the code of the city changes the account numbers of the connections that are
                created afterwards. The connections that already exist keep their number.
            </p>
        </div>
    </div>
</div>
