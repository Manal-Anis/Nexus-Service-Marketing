@model CityFormViewModel
@{
    ViewData["Title"] = "Register a city";
}

<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" asp-area="Admin" asp-controller="Cities" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="glass p-4 mb-4">
                <h2 class="h5 mb-3">The city</h2>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label" asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" placeholder="Karachi" />
                        <span asp-validation-for="Name" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" asp-for="Code3"></label>
                        <input asp-for="Code3" class="form-control" maxlength="3" placeholder="001" />
                        <span asp-validation-for="Code3" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label" asp-for="IsActive">The city is served by the network</label>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-gold" type="submit"><i class="bi bi-check2-circle me-1"></i>Register the city</button>
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Cities" asp-action="Index">Cancel</a>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="glass p-4">
            <h2 class="h6 mb-3">How the account number is built</h2>
            <p class="text-muted-silver fs-14">
                One letter for the service, three digits for the city and twelve digits for the
                serial of the connection:
            </p>
            <p class="mb-0"><span class="account-id-chip">B001000000000001</span></p>
            <ul class="timeline mt-3">
                <li class="timeline-item">
                    <span class="timeline-dot done"></span>
                    <div class="timeline-title">B - Broadband</div>
                    <div class="timeline-meta">D for dial-up and T for the landline</div>
                </li>
                <li class="timeline-item">
                    <span class="timeline-dot done"></span>
                    <div class="timeline-title">001 - The city code</div>
                    <div class="timeline-meta">Karachi carries the code 001</div>
                </li>
                <li class="timeline-item">
                    <span class="timeline-dot done"></span>
                    <div class="timeline-title">000000000001 - The serial</div>
                    <div class="timeline-meta">The serial runs inside the city</div>
                </li>
            </ul>
        </div>
    </div>
</div>
