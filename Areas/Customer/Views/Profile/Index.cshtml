@model CustomerProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="glass p-4">
            <h2 class="h5 mb-3">Contact details</h2>
            <p class="text-muted-silver fs-14">The partner uses these details for the installation visit and for the monthly bill.</p>

            <form method="post" asp-area="Customer" asp-controller="Profile" asp-action="Index">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="FullName">Full name</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Phone">Phone number</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Email">Email address</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="CityId">City</label>
                        <select asp-for="CityId" class="form-select">
                            <option value="">Choose a city</option>
                            @foreach (var city in Model.Cities)
                            {
                                <option value="@city.Id">@city.Name (@city.Code3)</option>
                            }
                        </select>
                        <span asp-validation-for="CityId" class="text-danger fs-14"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Address">Installation address</label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger fs-14"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-gold">
                        <i class="bi bi-check2-circle me-1"></i>Save the profile
                    </button>
                    <a class="btn btn-ghost" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                        <i class="bi bi-key me-1"></i>Change the password
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="glass p-4">
            <h2 class="h5 mb-3">Good to know</h2>
            <div class="stat-line"><span class="k">Payment</span><span class="v">Cash on delivery</span></div>
            <div class="stat-line"><span class="k">Invoices</span><span class="v">Payable at the retail counter</span></div>
            <div class="stat-line"><span class="k">Security deposit</span><span class="v">Refundable on disconnection</span></div>
            <div class="stat-line"><span class="k">Support</span><span class="v">Your partner handles the service</span></div>

            <div class="alert-nexus alert-info mt-4">
                <i class="bi bi-shield-lock"></i>
                <div class="fs-14">
                    Your documents and invoices are only visible to you and to the partner that serves your city.
                </div>
            </div>
        </div>
    </div>
</div>
